POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña
POSTGRES_DB=rimai_db
POSTGRES_PORT=5432
PGADMIN_EMAIL=tu_email@gmail.com
PGADMIN_PASSWORD=tu_contraseña_pgadmin

# Backend API (obligatorias en producción y Railway)
# Generar JWT: openssl rand -hex 32
# En Railway: Variables del servicio API → JWT_SECRET=<valor generado>
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
DATABASE_URL=postgresql://tu_usuario:tu_contraseña@localhost:5432/rimai_db

# CORS: orígenes separados por coma (obligatorio fuera de tests y Railway)
# En Railway, si se omite, se infiere de RAILWAY_PUBLIC_DOMAIN automáticamente.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000,https://rimai-production.up.railway.app

# Registro público de familias (false en producción)
ALLOW_PUBLIC_REGISTER=true

# Rate limiting auth (deshabilitar solo en tests)
# RATE_LIMIT_ENABLED=true

# Pool de conexiones PostgreSQL (opcional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Evaluar alertas clínicas en cada GET /api/dashboard/resumen (default: false)
EVALUAR_ALERTAS_EN_RESUMEN=false

# Solo para tests locales (pytest)
# RIMAI_ALLOW_TEST_DEFAULTS=1
